# Shared localhost Google OAuth client (public browser identifier, not a secret).
GOOGLE_CLIENT_ID=610984601873-obcs09oonbadi58tvgkhr1sbr4muiv92.apps.googleusercontent.com

# Generate a long random value for production. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Set true only when the site is served through HTTPS.
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost,http://localhost:3000

# Optional local-only fallback. Keep false in deployed environments.
ALLOW_MOCK_AUTH=false
